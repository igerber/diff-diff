+        effects = {1.0: 0.5, 2.0: 2.0, 4.0: 1.0}  # non-monotone ACRT
+        df = _make_discrete_panel(effects, n_per_level=60, n_control=100, noise=0.0, seed=4)
+        res = ContinuousDiD(treatment_type="discrete", n_bootstrap=0).fit(df, **self._KW)

+        res = ContinuousDiD(treatment_type="discrete", n_bootstrap=0).fit(df, **self._KW)
+        _, _, _, se = _hand_calc_discrete(df, levels)
+        assert np.allclose(res.dose_response_att.se, se, atol=1e-10)
